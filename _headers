# Cabeceras de seguridad y caché para Cloudflare Pages.
# Súbelo junto con los demás archivos (va en la raíz, al lado de index.html).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  # Protección que no puede romper ninguna función de la app:
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'
  # Política completa en modo "solo avisar": no bloquea nada, solo escribe en la consola (F12) lo que bloquearía.
  # Si después de unos días no ves avisos, puedes cambiarla a Content-Security-Policy para que se aplique.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://www.googleapis.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://drive.google.com; worker-src 'self' blob:; manifest-src 'self'

# Estos archivos se revisan siempre contra internet para que las actualizaciones lleguen enseguida.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/pedido.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Íconos: se pueden guardar un día.
/icon*
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
